{
  "manifest_version": 2,
  "name": "MailZip",
  "version": "0.2.4",
  "description": "Automatically zip email attachments that match your rules (extension + size), before sending or right after you add them.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mailzip@ximalu.dev",
      "strict_min_version": "98.0"
    }
  },
  "permissions": ["compose", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
